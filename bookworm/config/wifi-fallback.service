[Unit]
Description=WiFi Fallback Hotspot Service
After=network.target NetworkManager.service NetworkManager-wait-online.service
Wants=network.target NetworkManager-wait-online.service

[Service]
Type=simple
ExecStart=/usr/local/bin/wifi-fallback.sh
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
